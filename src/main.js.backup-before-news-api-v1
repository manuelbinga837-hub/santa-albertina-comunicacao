function renderCurrentPage() {
  const currentRoute = getCurrentRoute();

  let content = "";

  switch (currentRoute.page) {
    case "Dashboard":
      content = Dashboard();
      break;

    case "Noticias":
      content = Noticias();
      break;

    case "Eventos":
      content = `
        <section class="communication-page">
          <h1>Eventos</h1>
          <p>Página de eventos em construção.</p>
        </section>
      `;
      break;

    case "Galeria":
      content = `
        <section class="communication-page">
          <h1>Galeria</h1>
          <p>Página de galeria em construção.</p>
        </section>
      `;
      break;

    case "Videos":
      content = `
        <section class="communication-page">
          <h1>Vídeos</h1>
          <p>Página de vídeos em construção.</p>
        </section>
      `;
      break;

    case "Mensagens":
      content = `
        <section class="communication-page">
          <h1>Mensagens</h1>
          <p>Página de mensagens em construção.</p>
        </section>
      `;
      break;

    case "Configuracoes":
      content = `
        <section class="communication-page">
          <h1>Configurações</h1>
          <p>Página de configurações em construção.</p>
        </section>
      `;
      break;

    case "Conta":
      content = `
        <section class="communication-page">
          <h1>Minha conta</h1>
          <p>Página da conta em construção.</p>
        </section>
      `;
      break;

    default:
      content = Dashboard();
  }

  app.innerHTML = CommunicationLayout(content, currentRoute.path);

  setupMobileMenu();
  setupPublicationModal();
  setupNewsModal();
}

function setupMobileMenu() {
  const menuButton = document.querySelector("#sidebar-open");
  const sidebar = document.querySelector("#communication-sidebar");
  const sidebarClose = document.querySelector("#sidebar-close");
  const overlay = document.querySelector("#communication-overlay");

  if (!menuButton || !sidebar || !sidebarClose || !overlay) {
    return;
  }

  function openSidebar() {
    sidebar.classList.add("is-open");
    overlay.classList.add("is-visible");
    overlay.setAttribute("aria-hidden", "false");
  }

  function closeSidebar() {
    sidebar.classList.remove("is-open");
    overlay.classList.remove("is-visible");
    overlay.setAttribute("aria-hidden", "true");
  }

  menuButton.addEventListener("click", openSidebar);
  sidebarClose.addEventListener("click", closeSidebar);
  overlay.addEventListener("click", closeSidebar);

  sidebar.querySelectorAll("a[data-route]").forEach((item) => {
    item.addEventListener("click", closeSidebar);
  });
}

function setupNewsModal() {
  const openButton = document.querySelector(
    '[data-action="new-news"]'
  );

  const modal = document.querySelector(
    "#news-create-modal"
  );

  const closeButton = document.querySelector(
    "#news-create-modal-close"
  );

  const cancelButton = document.querySelector(
    "#news-create-cancel"
  );

  const form = document.querySelector(
    "#news-create-form"
  );

  const statusSelect = document.querySelector(
    "#news-status"
  );

  const scheduledField = document.querySelector(
    "#news-scheduled-at-field"
  );

  const fileInput = document.querySelector(
    "#news-cover-file"
  );

  const coverUrlInput = document.querySelector(
    "#news-cover-url"
  );

  const coverLinkButton = document.querySelector(
    "#news-cover-link-button"
  );

  const preview = document.querySelector(
    "#news-cover-preview"
  );

  if (
    !openButton ||
    !modal ||
    !closeButton ||
    !cancelButton ||
    !form
  ) {
    return;
  }

  let selectedObjectUrl = null;

  function closeModal() {
    modal.classList.remove("is-visible");
    modal.setAttribute("aria-hidden", "true");

    document.body.style.overflow = "";
  }

  function openModal() {
    modal.classList.add("is-visible");
    modal.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";
  }

  function updateScheduledField() {
    if (!statusSelect || !scheduledField) {
      return;
    }

    const isScheduled =
      statusSelect.value === "SCHEDULED";

    scheduledField.hidden = !isScheduled;
  }

  function showPreview(src) {
    if (!preview || !src) {
      return;
    }

    preview.innerHTML = `
      <img
        src="${src}"
        alt="Pré-visualização da imagem de capa"
      />
    `;
  }

  function resetPreview() {
    if (!preview) {
      return;
    }

    preview.innerHTML = `
      <span>🖼️</span>
      <small>
        A pré-visualização aparecerá aqui
      </small>
    `;
  }

  function handleFileChange() {
    const file = fileInput?.files?.[0];

    if (!file) {
      return;
    }

    if (!file.type.startsWith("image/")) {
      if (fileInput) {
        fileInput.value = "";
      }

      return;
    }

    if (selectedObjectUrl) {
      URL.revokeObjectURL(selectedObjectUrl);
    }

    selectedObjectUrl = URL.createObjectURL(file);

    showPreview(selectedObjectUrl);

    if (coverUrlInput) {
      coverUrlInput.value = "";
    }
  }

  function handleCoverLink() {
    const url = coverUrlInput?.value.trim();

    if (!url) {
      return;
    }

    try {
      new URL(url);
    } catch {
      coverUrlInput.focus();
      return;
    }

    if (selectedObjectUrl) {
      URL.revokeObjectURL(selectedObjectUrl);
      selectedObjectUrl = null;
    }

    if (fileInput) {
      fileInput.value = "";
    }

    showPreview(url);
  }

  openButton.addEventListener("click", openModal);

  closeButton.addEventListener("click", closeModal);

  cancelButton.addEventListener("click", closeModal);

  modal
    .querySelectorAll("[data-close-news-modal]")
    .forEach((element) => {
      element.addEventListener("click", closeModal);
    });

  if (statusSelect) {
    statusSelect.addEventListener(
      "change",
      updateScheduledField
    );

    updateScheduledField();
  }

  if (fileInput) {
    fileInput.addEventListener(
      "change",
      handleFileChange
    );
  }

  if (coverLinkButton) {
    coverLinkButton.addEventListener(
      "click",
      handleCoverLink
    );
  }

  if (coverUrlInput) {
    coverUrlInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        handleCoverLink();
      }
    });
  }

  form.addEventListener("reset", () => {
    if (selectedObjectUrl) {
      URL.revokeObjectURL(selectedObjectUrl);
      selectedObjectUrl = null;
    }

    resetPreview();

    if (scheduledField) {
      scheduledField.hidden = true;
    }
  });

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      modal.classList.contains("is-visible")
    ) {
      closeModal();
    }
  });

  window.addEventListener("beforeunload", () => {
    if (selectedObjectUrl) {
      URL.revokeObjectURL(selectedObjectUrl);
    }
  });
}

function setupPublicationModal() {
  const openButton = document.querySelector("#dashboard-new-publication");
  const modal = document.querySelector("#publication-modal");
  const closeButton = document.querySelector("#publication-modal-close");

  if (!openButton || !modal || !closeButton) {
    return;
  }

  const closeModal = () => {
    modal.classList.remove("is-visible");
    modal.setAttribute("aria-hidden", "true");
  };

  const openModal = () => {
    modal.classList.add("is-visible");
    modal.setAttribute("aria-hidden", "false");
  };

  openButton.addEventListener("click", openModal);
  closeButton.addEventListener("click", closeModal);

  modal.querySelectorAll("[data-close-publication-modal]").forEach((element) => {
    element.addEventListener("click", closeModal);
  });

  modal.querySelectorAll("[data-publication-route]").forEach((option) => {
    option.addEventListener("click", () => {
      const route = option.dataset.publicationRoute;

      closeModal();

      if (route) {
        navigate(route);
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modal.classList.contains("is-visible")) {
      closeModal();
    }
  });
}

document.addEventListener("click", (event) => {
  const target = event.target.closest("[data-route]");

  if (!target) {
    return;
  }

  event.preventDefault();

  const route = target.dataset.route;

  if (route) {
    navigate(route);
  }
});

async function startCommunicationApp() {
  if (!isAuthenticated()) {
    app.innerHTML = Login();
    setupLogin();
    return;
  }

  try {
    await getCurrentUser();

    startRouter(renderCurrentPage);
  } catch (error) {
    logout();

    app.innerHTML = Login();
    setupLogin();
  }
}

startCommunicationApp();
