.events-page {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

/* HERO */

.events-hero {
  position: relative;
  min-height: 320px;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24px;
  background:
    radial-gradient(circle at 75% 30%, rgba(59, 130, 246, 0.18), transparent 35%),
    linear-gradient(135deg, #11161d 0%, #151d28 55%, #10151c 100%);
}

.events-hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 44px;
}

.events-eyebrow,
.events-section-eyebrow {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  margin-bottom: 12px;
  color: #f5c451;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.events-hero h1 {
  max-width: 620px;
  margin: 0;
  color: #f5f7fa;
  font-size: clamp(30px, 4vw, 48px);
  line-height: 1.08;
  letter-spacing: -0.035em;
}

.events-hero p {
  max-width: 560px;
  margin: 18px 0 0;
  color: #aeb7c3;
  font-size: 15px;
  line-height: 1.7;
}

.events-hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 24px;
}

.events-hero-tags span {
  padding: 8px 12px;
  border: 1px solid rgba(245, 196, 81, 0.18);
  border-radius: 999px;
  background: rgba(245, 196, 81, 0.07);
  color: #d8dee7;
  font-size: 12px;
}

/* HERO VISUAL */

.events-hero-visual {
  position: relative;
  min-height: 320px;
  overflow: hidden;
}

.events-hero-stage {
  position: absolute;
  inset: 0;
}

.events-hero-stage::before,
.events-hero-stage::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  filter: blur(2px);
}

.events-hero-stage::before {
  width: 230px;
  height: 230px;
  top: 38px;
  right: 55px;
  background: rgba(245, 196, 81, 0.12);
  box-shadow: 0 0 90px rgba(245, 196, 81, 0.08);
}

.events-hero-stage::after {
  width: 180px;
  height: 180px;
  bottom: 20px;
  left: 30px;
  background: rgba(59, 130, 246, 0.1);
}

.events-hero-light {
  position: absolute;
  top: 45px;
  right: 110px;
  width: 90px;
  height: 90px;
  border: 1px solid rgba(245, 196, 81, 0.4);
  border-radius: 50%;
  background: rgba(245, 196, 81, 0.08);
  box-shadow:
    0 0 45px rgba(245, 196, 81, 0.18),
    inset 0 0 25px rgba(245, 196, 81, 0.08);
}

.events-hero-light::after {
  content: "";
  position: absolute;
  top: 100%;
  left: 50%;
  width: 1px;
  height: 145px;
  background: linear-gradient(
    to bottom,
    rgba(245, 196, 81, 0.3),
    transparent
  );
}

.events-hero-seat {
  position: absolute;
  bottom: 65px;
  width: 68px;
  height: 72px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px 8px 4px 4px;
  background: linear-gradient(135deg, #222c38, #151c25);
}

.events-hero-seat::before {
  content: "";
  position: absolute;
  left: 7px;
  right: 7px;
  bottom: -22px;
  height: 24px;
  border-left: 2px solid #293442;
  border-right: 2px solid #293442;
}

.events-hero-seat-one {
  right: 205px;
}

.events-hero-seat-two {
  right: 120px;
  bottom: 55px;
  transform: scale(1.08);
}

.events-hero-seat-three {
  right: 35px;
}

.events-hero-platform {
  position: absolute;
  right: 15px;
  bottom: 30px;
  width: 290px;
  height: 26px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  background: linear-gradient(
    180deg,
    #26313e,
    #151c24
  );
  box-shadow: 0 14px 35px rgba(0, 0, 0, 0.28);
}

/* CABEÇALHO */

.events-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.events-header h2 {
  margin: 0;
  color: #f5f7fa;
  font-size: 28px;
  letter-spacing: -0.02em;
}

.events-header p {
  margin: 7px 0 0;
  color: #8d96a3;
  font-size: 14px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 17px;
  border-radius: 10px;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.primary-button {
  border: 1px solid #3b82f6;
  background: #3b82f6;
  color: #ffffff;
}

.primary-button:hover {
  background: #2563eb;
  transform: translateY(-1px);
}

.events-new-button span {
  font-size: 19px;
  line-height: 1;
}

/* TOOLBAR */

.events-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
}

.events-search {
  position: relative;
  flex: 1;
}

.events-search-icon {
  position: absolute;
  top: 50%;
  left: 15px;
  color: #697382;
  font-size: 19px;
  transform: translateY(-50%);
  pointer-events: none;
}

.events-search input,
.events-filters select {
  width: 100%;
  min-height: 46px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 10px;
  outline: none;
  background: #11161d;
  color: #f5f7fa;
  font: inherit;
  font-size: 13px;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.events-search input {
  padding: 0 15px 0 43px;
}

.events-filters {
  width: 190px;
}

.events-search input::placeholder {
  color: #68717e;
}

.events-search input:focus,
.events-filters select:focus {
  border-color: rgba(59, 130, 246, 0.65);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

/* CONTENT */

.events-content {
  min-height: 220px;
}

.events-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

/* EVENT CARD */

.event-card {
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18px;
  background: #11161d;
}

.event-card-image {
  position: relative;
  height: 210px;
  overflow: hidden;
  background:
    linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.25),
      rgba(245, 196, 81, 0.1)
    ),
    #1a222d;
}

.event-card-image::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      circle at 70% 30%,
      rgba(245, 196, 81, 0.16),
      transparent 30%
    );
}

.event-card-body {
  padding: 20px;
}

.event-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
}

.event-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 66px;
  min-height: 70px;
  border: 1px solid rgba(245, 196, 81, 0.22);
  border-radius: 12px;
  background: rgba(245, 196, 81, 0.07);
}

.event-date-day {
  color: #f5c451;
  font-size: 25px;
  font-weight: 800;
  line-height: 1;
}

.event-date-month {
  margin-top: 5px;
  color: #aeb7c3;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.event-card-title {
  margin: 16px 0 0;
  color: #f5f7fa;
  font-size: 19px;
  line-height: 1.3;
}

.event-card-meta {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 13px;
  color: #929ba8;
  font-size: 13px;
}

.event-card-meta span {
  display: flex;
  align-items: center;
  gap: 7px;
}

.event-card-menu {
  position: relative;
}

/* EMPTY STATE */

.events-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 260px;
  padding: 40px 20px;
  border: 1px dashed rgba(255, 255, 255, 0.12);
  border-radius: 18px;
  background: rgba(17, 22, 29, 0.45);
  text-align: center;
}

.events-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  margin-bottom: 16px;
  border: 1px solid rgba(245, 196, 81, 0.2);
  border-radius: 50%;
  background: rgba(245, 196, 81, 0.07);
  color: #f5c451;
  font-size: 25px;
}

.events-empty h3 {
  margin: 0;
  color: #f5f7fa;
  font-size: 18px;
}

.events-empty p {
  max-width: 440px;
  margin: 9px 0 20px;
  color: #8d96a3;
  font-size: 13px;
  line-height: 1.6;
}

.secondary-button {
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: #171d25;
  color: #dce2e9;
}

.secondary-button:hover {
  border-color: rgba(59, 130, 246, 0.45);
  background: #1d2530;
}

/* RESPONSIVO */

@media (max-width: 900px) {
  .events-hero {
    grid-template-columns: 1fr;
  }

  .events-hero-content {
    padding: 34px;
  }

  .events-hero-visual {
    display: none;
  }

  .events-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .events-page {
    gap: 22px;
  }

  .events-hero {
    min-height: 0;
    border-radius: 18px;
  }

  .events-hero-content {
    padding: 28px 22px;
  }

  .events-hero h1 {
    font-size: 30px;
  }

  .events-header {
    align-items: stretch;
    flex-direction: column;
  }

  .events-new-button {
    width: 100%;
  }

  .events-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .events-filters {
    width: 100%;
  }

  .events-card-image {
    height: 190px;
  }

  .event-card-body {
    padding: 17px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .primary-button,
  .secondary-button,
  .events-search input,
  .events-filters select {
    transition: none;
  }
}

.events-hero-visual {
  position: relative;
  min-height: 320px;
  overflow: hidden;
}

.events-hero-image {
  width: 100%;
  height: 100%;
  min-height: 320px;
  display: block;
  object-fit: cover;
  object-position: center;
}

.events-hero-image-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(17, 22, 29, 0.05) 0%,
      rgba(17, 22, 29, 0.12) 45%,
      rgba(11, 15, 20, 0.42) 100%
    );
}

@media (max-width: 900px) {
  .events-hero-visual {
    display: block;
    min-height: 220px;
  }

  .events-hero-image {
    min-height: 220px;
  }
}

@media (max-width: 640px) {
  .events-hero-visual {
    min-height: 180px;
  }

  .events-hero-image {
    min-height: 180px;
  }
}

/* CORREÇÃO FINAL DO FUNDO DO HERO */

.events-hero {
  position: relative;
  display: flex;
  min-height: 320px;
  overflow: hidden;
  isolation: isolate;
}

.events-hero-background {
  position: absolute;
  inset: 0;
  z-index: 0;

  width: 100%;
  height: 100%;
  min-height: 0;

  display: block;
  object-fit: cover;
  object-position: center;

  background: none;

  pointer-events: none;
}

.events-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(11, 15, 20, 0.96) 0%,
      rgba(11, 15, 20, 0.82) 35%,
      rgba(11, 15, 20, 0.48) 65%,
      rgba(11, 15, 20, 0.28) 100%
    );

  pointer-events: none;
}

.events-hero-content {
  position: relative;
  z-index: 2;
  width: 60%;
}

@media (max-width: 900px) {
  .events-hero-content {
    width: 100%;
  }
}

/* DESCRIÇÃO DOS CARTÕES DE EVENTOS */

.event-card-content > p {
  margin: 0.75rem 0 1rem;

  color: #aeb7c4;
  font-size: 0.92rem;
  line-height: 1.65;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;

  min-height: 4.5em;
}

.event-card-content h3 {
  margin-bottom: 0;
  line-height: 1.3;
}

.event-card-meta {
  margin-top: auto;
}


/* =========================================================
   ACABAMENTO FINAL — CONTEÚDO DOS CARDS DE EVENTOS
   ========================================================= */

.events-grid .event-card {
  overflow: hidden;
}

.events-grid .event-card-content {
  padding: 1.25rem 1.3rem 1.35rem;
  display: flex;
  flex-direction: column;
  min-height: 205px;
  box-sizing: border-box;
}

.events-grid .event-card-status {
  display: inline-flex;
  align-self: flex-start;
  align-items: center;

  margin-bottom: 0.7rem;
  padding: 0.3rem 0.65rem;

  border: 1px solid rgba(59, 130, 246, 0.25);
  border-radius: 999px;

  background: rgba(59, 130, 246, 0.1);
  color: #78aaff;

  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.events-grid .event-card-content h3 {
  margin: 0;
  padding: 0;

  color: #f5f7fa;
  font-size: 1.12rem;
  font-weight: 700;
  line-height: 1.35;
}

.events-grid .event-card-content > p {
  margin: 0.75rem 0 1.15rem;
  padding: 0;

  color: #aeb7c4;
  font-size: 0.9rem;
  font-weight: 400;
  line-height: 1.65;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.events-grid .event-card-meta {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;

  margin-top: auto;
  padding-top: 0.9rem;

  border-top: 1px solid rgba(255, 255, 255, 0.07);
}

.events-grid .event-card-meta span {
  display: flex;
  align-items: center;
  gap: 0.45rem;

  color: #8f99a7;
  font-size: 0.78rem;
  line-height: 1.4;
}

@media (max-width: 600px) {
  .events-grid .event-card-content {
    padding: 1.1rem 1.05rem 1.2rem;
    min-height: 0;
  }

  .events-grid .event-card-content > p {
    margin-top: 0.7rem;
    margin-bottom: 1rem;
  }
}

