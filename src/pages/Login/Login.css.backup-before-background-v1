.login-page {
  min-height: 100vh;
  min-height: 100svh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(59, 130, 246, 0.14),
      transparent 34%
    ),
    radial-gradient(
      circle at 85% 80%,
      rgba(245, 196, 81, 0.08),
      transparent 30%
    ),
    #0b0f14;
  color: #f5f7fa;
}

.login-background {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px
    );
  background-size: 42px 42px;
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.8),
    transparent 90%
  );
}

.login-container {
  width: min(100%, 460px);
  position: relative;
  z-index: 1;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 22px;
}

.login-brand-mark {
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: linear-gradient(
    135deg,
    #3b82f6,
    #2563eb
  );
  color: #fff;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.04em;
  box-shadow:
    0 12px 30px rgba(37, 99, 235, 0.24);
}

.login-brand strong {
  display: block;
  color: #f5f7fa;
  font-size: 15px;
  font-weight: 750;
  line-height: 1.2;
}

.login-brand span {
  display: block;
  margin-top: 4px;
  color: #8d96a3;
  font-size: 12px;
}

.login-card {
  padding: 34px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 22px;
  background:
    linear-gradient(
      145deg,
      rgba(23, 29, 37, 0.98),
      rgba(17, 22, 29, 0.98)
    );
  box-shadow:
    0 28px 70px rgba(0, 0, 0, 0.36);
}

.login-header {
  margin-bottom: 28px;
}

.login-eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  padding: 0 10px;
  border: 1px solid rgba(59, 130, 246, 0.24);
  border-radius: 999px;
  background: rgba(59, 130, 246, 0.08);
  color: #78aafc;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.login-header h1 {
  margin: 16px 0 9px;
  color: #f5f7fa;
  font-size: clamp(27px, 5vw, 34px);
  line-height: 1.08;
  letter-spacing: -0.035em;
}

.login-header p {
  margin: 0;
  max-width: 390px;
  color: #8d96a3;
  font-size: 14px;
  line-height: 1.65;
}

.login-form {
  display: grid;
  gap: 18px;
}

.login-field {
  display: grid;
  gap: 8px;
}

.login-field label {
  color: #c5cbd3;
  font-size: 13px;
  font-weight: 650;
}

.login-field input {
  width: 100%;
  min-height: 50px;
  padding: 0 14px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 12px;
  outline: none;
  background: #0f141b;
  color: #f5f7fa;
  font: inherit;
  font-size: 14px;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease,
    background 160ms ease;
}

.login-field input::placeholder {
  color: #68727f;
}

.login-field input:focus {
  border-color: rgba(59, 130, 246, 0.72);
  background: #111821;
  box-shadow:
    0 0 0 3px rgba(59, 130, 246, 0.12);
}

.login-submit {
  width: 100%;
  min-height: 52px;
  margin-top: 4px;
  border: 0;
  border-radius: 12px;
  background: #3b82f6;
  color: #fff;
  cursor: pointer;
  font: inherit;
  font-size: 14px;
  font-weight: 750;
  transition:
    transform 160ms ease,
    background 160ms ease,
    opacity 160ms ease;
}

.login-submit:hover {
  background: #2563eb;
  transform: translateY(-1px);
}

.login-submit:active {
  transform: translateY(0);
}

.login-submit:disabled {
  cursor: wait;
  opacity: 0.65;
  transform: none;
}

.login-error {
  padding: 12px 13px;
  border: 1px solid rgba(239, 98, 98, 0.24);
  border-radius: 10px;
  background: rgba(239, 98, 98, 0.08);
  color: #ff9b9b;
  font-size: 13px;
  line-height: 1.5;
}

.login-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 24px;
  color: #68727f;
  font-size: 11px;
}

.login-public-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: 18px;
  color: #8d96a3;
  font-size: 12px;
  text-decoration: none;
  transition: color 160ms ease;
}

.login-public-link:hover {
  color: #c5cbd3;
}

@media (max-width: 520px) {
  .login-page {
    align-items: flex-start;
    padding: 24px 16px 28px;
  }

  .login-container {
    width: 100%;
    max-width: 430px;
    margin-top: 4vh;
  }

  .login-card {
    padding: 25px 20px;
    border-radius: 18px;
  }

  .login-brand {
    margin-bottom: 18px;
  }

  .login-header h1 {
    font-size: 28px;
  }

  .login-field input,
  .login-submit {
    min-height: 52px;
  }
}

@media (max-width: 360px) {
  .login-page {
    padding-inline: 12px;
  }

  .login-card {
    padding: 22px 16px;
  }

  .login-header p {
    font-size: 13px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .login-field input,
  .login-submit,
  .login-public-link {
    transition: none;
  }
}
