.messages-page {
  color: var(--text-primary, #172033);
  padding: 8px 0 28px;
}

.messages-page__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.messages-page__heading h1 {
  margin: 5px 0 8px;
  font-size: clamp(1.65rem, 4vw, 2rem);
  font-weight: 750;
}

.messages-page__heading p {
  margin: 0;
  color: #718096;
  line-height: 1.6;
}

.messages-eyebrow {
  color: #4773c8;
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .1em;
}

.messages-button {
  min-height: 42px;
  padding: 10px 15px;
  border: 1px solid #dbe2ec;
  border-radius: 10px;
  background: #fff;
  color: #25334a;
  font: inherit;
  font-weight: 650;
  cursor: pointer;
}

.messages-button:hover {
  background: #f3f6fb;
}

.messages-button:disabled {
  opacity: .55;
  cursor: wait;
}

.messages-button--primary {
  border-color: #315fc0;
  background: #315fc0;
  color: #fff;
}

.messages-button--primary:hover {
  background: #244c9e;
}

.messages-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 22px;
}

.messages-stat {
  padding: 18px;
  border: 1px solid #e5eaf2;
  border-radius: 14px;
  background: #fff;
}

.messages-stat span {
  display: block;
  color: #758197;
  font-size: .85rem;
}

.messages-stat strong {
  display: block;
  margin-top: 8px;
  font-size: 1.8rem;
}

.messages-workspace {
  display: grid;
  grid-template-columns: minmax(280px, .95fr) minmax(0, 1.35fr);
  gap: 18px;
  align-items: stretch;
}

.messages-inbox,
.message-details {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #e5eaf2;
  border-radius: 15px;
  background: #fff;
}

.messages-inbox__heading {
  padding: 19px 18px 12px;
}

.messages-inbox__heading h2 {
  margin: 0 0 7px;
  font-size: 1.05rem;
}

.messages-inbox__heading span {
  color: #8290a5;
  font-size: .78rem;
}

.messages-search {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 14px 12px;
  padding: 0 12px;
  border: 1px solid #e1e7f0;
  border-radius: 10px;
  color: #748198;
}

.messages-search input {
  width: 100%;
  min-width: 0;
  min-height: 43px;
  border: 0;
  outline: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  font-size: 16px;
}

.messages-filters {
  display: flex;
  gap: 5px;
  padding: 0 14px 12px;
  border-bottom: 1px solid #edf0f5;
}

.messages-filters button {
  min-height: 35px;
  padding: 7px 10px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #6b7890;
  font: inherit;
  font-size: .82rem;
  cursor: pointer;
}

.messages-filters button.is-active {
  background: #eaf0ff;
  color: #315fc0;
  font-weight: 700;
}

.messages-list {
  min-height: 230px;
}

.message-item {
  display: flex;
  width: 100%;
  gap: 11px;
  align-items: flex-start;
  padding: 15px 13px;
  border: 0;
  border-bottom: 1px solid #edf0f5;
  background: #fff;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.message-item:hover {
  background: #f8faff;
}

.message-item.is-selected {
  background: #eef3ff;
}

.message-item.is-unread .message-item__subject,
.message-item.is-unread .message-item__top strong {
  color: #1d2c46;
  font-weight: 800;
}

.message-item__avatar,
.message-sender__avatar {
  display: grid;
  flex: 0 0 40px;
  width: 40px;
  height: 40px;
  place-items: center;
  border-radius: 50%;
  background: #e9effd;
  color: #315fc0;
  font-weight: 800;
}

.message-item__content {
  display: block;
  flex: 1;
  min-width: 0;
}

.message-item__top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}

.message-item__top strong {
  overflow: hidden;
  font-size: .88rem;
  text-overflow: ellipsis;
}

.message-item time {
  flex-shrink: 0;
  color: #8290a5;
  font-size: .7rem;
}

.message-item__subject,
.message-item__preview {
  display: block;
  overflow: hidden;
  margin-top: 5px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-item__subject {
  color: #42516a;
  font-size: .83rem;
}

.message-item__preview {
  color: #8290a5;
  font-size: .78rem;
}

.message-item__dot {
  flex: 0 0 8px;
  width: 8px;
  height: 8px;
  margin-top: 6px;
  border-radius: 50%;
  background: #315fc0;
}

.message-details {
  padding: 24px;
}

.message-details__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  padding-bottom: 20px;
  border-bottom: 1px solid #edf0f5;
}

.message-details__header h2 {
  overflow-wrap: anywhere;
  margin: 8px 0 0;
  font-size: clamp(1.1rem, 3vw, 1.45rem);
}

.message-status {
  flex-shrink: 0;
  padding: 6px 9px;
  border-radius: 20px;
  font-size: .75rem;
  font-weight: 700;
}

.message-status--new {
  background: #fff2d9;
  color: #9a6200;
}

.message-status--read {
  background: #e5f7ed;
  color: #247447;
}

.message-sender {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 20px 0;
}

.message-sender strong {
  overflow-wrap: anywhere;
}

.message-sender p {
  margin: 5px 0 0;
  color: #8290a5;
  font-size: .8rem;
}

.message-contact-data {
  display: grid;
  gap: 12px;
  padding: 16px;
  border-radius: 12px;
  background: #f7f9fc;
}

.message-contact-data div {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.message-contact-data span {
  color: #8290a5;
  font-size: .78rem;
}

.message-contact-data strong {
  overflow-wrap: anywhere;
  font-size: .88rem;
}

.message-body {
  padding: 22px 0;
}

.message-body h3 {
  margin: 0 0 12px;
  font-size: .95rem;
}

.message-body p {
  overflow-wrap: anywhere;
  margin: 0;
  color: #4c5a70;
  line-height: 1.85;
}

.message-details__footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid #edf0f5;
}

.message-details__footer > span {
  color: #8290a5;
  font-size: .78rem;
}

.messages-empty,
.messages-loading,
.messages-error {
  padding: 35px 18px;
  color: #718096;
  text-align: center;
}

.messages-empty__icon {
  display: block;
  margin-bottom: 12px;
  color: #8da6db;
  font-size: 2rem;
}

.messages-empty strong,
.messages-error strong {
  display: block;
  color: #344158;
}

.messages-empty p,
.messages-error p {
  font-size: .85rem;
  line-height: 1.6;
}

.messages-empty--details {
  padding-top: 90px;
  padding-bottom: 90px;
}

.messages-error {
  color: #9c3d3d;
}

@media (max-width: 850px) {
  .messages-workspace {
    grid-template-columns: minmax(0, 1fr);
  }

  .message-details {
    min-height: 300px;
  }

  .messages-empty--details {
    padding: 55px 18px;
  }
}

@media (max-width: 520px) {
  .messages-page__heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .messages-stats {
    gap: 8px;
  }

  .messages-stat {
    padding: 12px 10px;
  }

  .messages-stat span {
    font-size: .73rem;
  }

  .messages-stat strong {
    font-size: 1.5rem;
  }

  .message-details {
    padding: 17px;
  }

  .message-details__header {
    flex-direction: column;
  }

  .message-item {
    padding: 13px 10px;
  }

  .message-item__top {
    flex-direction: column;
    gap: 3px;
  }
}
