.messages-page {
  color: #e8edf3;
  padding: 8px 0 28px;
  animation: messagesPageIn 360ms ease both;
}

@keyframes messagesPageIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.messages-page__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.messages-page__heading h1 {
  margin: 5px 0 8px;
  color: #fff;
  font-size: clamp(1.65rem, 4vw, 2rem);
  font-weight: 750;
}

.messages-page__heading p {
  margin: 0;
  color: #aeb7c2;
  line-height: 1.6;
}

.messages-eyebrow {
  color: #f5c451;
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .12em;
}

.messages-button {
  min-height: 42px;
  padding: 10px 15px;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 10px;
  background: rgba(255,255,255,.045);
  color: #e8edf3;
  font: inherit;
  font-weight: 650;
  cursor: pointer;
  transition: background .2s, border-color .2s;
}

.messages-button:hover {
  background: rgba(59,130,246,.14);
  border-color: rgba(59,130,246,.4);
}

.messages-button:disabled {
  opacity: .55;
  cursor: wait;
}

.messages-button--primary {
  border-color: #3b82f6;
  background: #3b82f6;
  color: #fff;
}

.messages-button--primary:hover {
  background: #2563eb;
}

.messages-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 22px;
}

.messages-stat {
  padding: 18px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 14px;
  background: linear-gradient(135deg, #102a3d, #101923);
}

.messages-stat span {
  display: block;
  color: #aeb7c2;
  font-size: .85rem;
}

.messages-stat strong {
  display: block;
  margin-top: 8px;
  color: #f5c451;
  font-size: 1.8rem;
}

.messages-workspace {
  display: grid;
  grid-template-columns: minmax(280px, .95fr) minmax(0, 1.35fr);
  gap: 18px;
  align-items: stretch;
}

.messages-inbox,
.message-details {
  min-width: 0;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 15px;
  background: #101923;
}

.messages-inbox__heading {
  padding: 19px 18px 12px;
}

.messages-inbox__heading h2 {
  margin: 0 0 7px;
  color: #fff;
  font-size: 1.05rem;
}

.messages-inbox__heading span {
  color: #aeb7c2;
  font-size: .78rem;
}

.messages-search {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 14px 12px;
  padding: 0 12px;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 10px;
  background: rgba(255,255,255,.035);
  color: #aeb7c2;
}

.messages-search:focus-within {
  border-color: rgba(59,130,246,.6);
}

.messages-search input {
  width: 100%;
  min-width: 0;
  min-height: 43px;
  border: 0;
  outline: 0;
  background: transparent;
  color: #fff;
  font: inherit;
  font-size: 16px;
}

.messages-search input::placeholder {
  color: #8793a2;
}

.messages-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  padding: 0 14px 12px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.messages-filters button {
  min-height: 35px;
  padding: 7px 10px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: #aeb7c2;
  font: inherit;
  font-size: .82rem;
  cursor: pointer;
}

.messages-filters button:hover {
  background: rgba(59,130,246,.10);
  color: #fff;
}

.messages-filters button.is-active {
  border-color: rgba(245,196,81,.22);
  background: rgba(245,196,81,.10);
  color: #f5c451;
  font-weight: 700;
}

.messages-list {
  min-height: 230px;
}

.message-item {
  display: flex;
  width: 100%;
  gap: 11px;
  align-items: flex-start;
  padding: 15px 13px;
  border: 0;
  border-bottom: 1px solid rgba(255,255,255,.07);
  background: transparent;
  color: #e8edf3;
  text-align: left;
  cursor: pointer;
}

.message-item:hover {
  background: rgba(59,130,246,.08);
}

.message-item.is-selected {
  background: rgba(59,130,246,.14);
  box-shadow: inset 3px 0 #f5c451;
}

.message-item.is-unread .message-item__subject,
.message-item.is-unread .message-item__top strong {
  color: #fff;
  font-weight: 800;
}

.message-item__avatar,
.message-sender__avatar {
  display: grid;
  flex: 0 0 40px;
  width: 40px;
  height: 40px;
  place-items: center;
  border: 1px solid rgba(245,196,81,.22);
  border-radius: 50%;
  background: rgba(245,196,81,.09);
  color: #f5c451;
  font-weight: 800;
}

.message-item__content {
  display: block;
  flex: 1;
  min-width: 0;
}

.message-item__top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}

.message-item__top strong {
  overflow: hidden;
  color: #e8edf3;
  font-size: .88rem;
  text-overflow: ellipsis;
}

.message-item time {
  flex-shrink: 0;
  color: #8793a2;
  font-size: .7rem;
}

.message-item__subject,
.message-item__preview {
  display: block;
  overflow: hidden;
  margin-top: 5px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-item__subject {
  color: #d5dce5;
  font-size: .83rem;
}

.message-item__preview {
  color: #aeb7c2;
  font-size: .78rem;
}

.message-item__dot {
  flex: 0 0 8px;
  width: 8px;
  height: 8px;
  margin-top: 6px;
  border-radius: 50%;
  background: #f5c451;
}

.message-details {
  padding: 24px;
}

.message-details__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(255,255,255,.09);
}

.message-details__header h2 {
  overflow-wrap: anywhere;
  margin: 8px 0 0;
  color: #fff;
  font-size: clamp(1.1rem, 3vw, 1.45rem);
}

.message-status {
  flex-shrink: 0;
  padding: 6px 9px;
  border-radius: 20px;
  font-size: .75rem;
  font-weight: 700;
}

.message-status--new {
  border: 1px solid rgba(245,196,81,.25);
  background: rgba(245,196,81,.10);
  color: #f5c451;
}

.message-status--read {
  border: 1px solid rgba(59,130,246,.25);
  background: rgba(59,130,246,.12);
  color: #93c5fd;
}

.message-sender {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 20px 0;
}

.message-sender strong {
  overflow-wrap: anywhere;
  color: #fff;
}

.message-sender p {
  margin: 5px 0 0;
  color: #aeb7c2;
  font-size: .8rem;
}

.message-contact-data {
  display: grid;
  gap: 12px;
  padding: 16px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 12px;
  background: rgba(255,255,255,.035);
}

.message-contact-data div {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.message-contact-data span {
  color: #aeb7c2;
  font-size: .78rem;
}

.message-contact-data strong {
  overflow-wrap: anywhere;
  color: #e8edf3;
  font-size: .88rem;
}

.message-body {
  padding: 22px 0;
}

.message-body h3 {
  margin: 0 0 12px;
  color: #f5c451;
  font-size: .95rem;
}

.message-body p {
  overflow-wrap: anywhere;
  margin: 0;
  color: #d5dce5;
  line-height: 1.85;
}

.message-details__footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid rgba(255,255,255,.09);
}

.message-details__footer > span {
  color: #aeb7c2;
  font-size: .78rem;
}

.messages-empty,
.messages-loading,
.messages-error {
  padding: 35px 18px;
  color: #aeb7c2;
  text-align: center;
}

.messages-empty__icon {
  display: block;
  margin-bottom: 12px;
  color: #f5c451;
  font-size: 2rem;
}

.messages-empty strong,
.messages-error strong {
  display: block;
  color: #fff;
}

.messages-empty p,
.messages-error p {
  color: #aeb7c2;
  font-size: .85rem;
  line-height: 1.6;
}

.messages-empty--details {
  padding-top: 90px;
  padding-bottom: 90px;
}

.messages-error {
  color: #fca5a5;
}

@media (max-width: 850px) {
  .messages-workspace {
    grid-template-columns: minmax(0, 1fr);
  }

  .message-details {
    min-height: 300px;
  }

  .messages-empty--details {
    padding: 55px 18px;
  }
}

@media (max-width: 520px) {
  .messages-page__heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .messages-stats {
    gap: 8px;
  }

  .messages-stat {
    padding: 12px 10px;
  }

  .messages-stat span {
    font-size: .73rem;
  }

  .messages-stat strong {
    font-size: 1.5rem;
  }

  .message-details {
    padding: 17px;
  }

  .message-details__header {
    flex-direction: column;
  }

  .message-item {
    padding: 13px 10px;
  }

  .message-item__top {
    flex-direction: column;
    gap: 3px;
  }
}
