function renderCurrentPage() {
  const currentRoute = getCurrentRoute();

  let content = "";

  switch (currentRoute.page) {
    case "Dashboard":
      content = Dashboard();
      break;

    case "Noticias":
      content = Noticias();
      break;

    case "Eventos":
      content = `
        <section class="communication-page">
          <h1>Eventos</h1>
          <p>Página de eventos em construção.</p>
        </section>
      `;
      break;

    case "Galeria":
      content = `
        <section class="communication-page">
          <h1>Galeria</h1>
          <p>Página de galeria em construção.</p>
        </section>
      `;
      break;

    case "Videos":
      content = `
        <section class="communication-page">
          <h1>Vídeos</h1>
          <p>Página de vídeos em construção.</p>
        </section>
      `;
      break;

    case "Mensagens":
      content = `
        <section class="communication-page">
          <h1>Mensagens</h1>
          <p>Página de mensagens em construção.</p>
        </section>
      `;
      break;

    case "Configuracoes":
      content = `
        <section class="communication-page">
          <h1>Configurações</h1>
          <p>Página de configurações em construção.</p>
        </section>
      `;
      break;

    case "Conta":
      content = `
        <section class="communication-page">
          <h1>Minha conta</h1>
          <p>Página da conta em construção.</p>
        </section>
      `;
      break;

    default:
      content = Dashboard();
  }

  app.innerHTML = CommunicationLayout(content);

  updateActiveNavigation(currentRoute.path);
  setupMobileMenu();
}

function updateActiveNavigation(path) {
  document.querySelectorAll(".nav-item").forEach((item) => {
    item.classList.toggle(
      "active",
      item.dataset.route === path
    );
  });
}

function setupMobileMenu() {
  const menuButton = document.querySelector("#menuButton");
  const sidebar = document.querySelector("#sidebar");
  const sidebarClose = document.querySelector("#sidebarClose");
  const sidebarOverlay = document.querySelector("#sidebarOverlay");

  if (!menuButton || !sidebar || !sidebarClose || !sidebarOverlay) {
    return;
  }

  function openSidebar() {
    sidebar.classList.add("open");
    sidebarOverlay.classList.add("visible");
  }

  function closeSidebar() {
    sidebar.classList.remove("open");
    sidebarOverlay.classList.remove("visible");
  }

  menuButton.addEventListener("click", openSidebar);
  sidebarClose.addEventListener("click", closeSidebar);
  sidebarOverlay.addEventListener("click", closeSidebar);

  document.querySelectorAll(".nav-item[data-route]").forEach((item) => {
    item.addEventListener("click", closeSidebar);
  });
}

document.addEventListener("click", (event) => {
  const target = event.target.closest("[data-route]");

  if (!target) {
    return;
  }

  event.preventDefault();

  const route = target.dataset.route;

  if (route) {
    navigate(route);
  }
});

