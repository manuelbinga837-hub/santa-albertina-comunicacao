        </section>
      `;
      break;

    case "Videos":
      content = `
        <section class="communication-page">
          <h1>Vídeos</h1>
          <p>Página de vídeos em construção.</p>
        </section>
      `;
      break;

    case "Mensagens":
      content = `
        <section class="communication-page">
          <h1>Mensagens</h1>
          <p>Página de mensagens em construção.</p>
        </section>
      `;
      break;

    case "Configuracoes":
      content = `
        <section class="communication-page">
          <h1>Configurações</h1>
          <p>Página de configurações em construção.</p>
        </section>
      `;
      break;

