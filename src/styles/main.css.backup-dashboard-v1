:root {
  --bg: #0d0f13;
  --surface: #15181e;
  --surface-2: #1b1f27;
  --surface-3: #222731;
  --border: #292f3a;
  --text: #f2f4f7;
  --muted: #929aa8;
  --muted-2: #69717f;
  --accent: #8b7cff;
  --accent-soft: rgba(139, 124, 255, 0.13);
  --success: #55c48a;
  --danger: #ef6b73;
  --sidebar-width: 250px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-width: 320px;
  background: var(--bg);
  color: var(--text);
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button,
a {
  font: inherit;
}

button {
  border: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

.communication-app {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(circle at 80% 0%, rgba(139, 124, 255, 0.06), transparent 28%),
    var(--bg);
}

.sidebar {
  width: var(--sidebar-width);
  min-height: 100vh;
  position: fixed;
  inset: 0 auto 0 0;
  display: flex;
  flex-direction: column;
  background: rgba(18, 21, 27, 0.96);
  border-right: 1px solid var(--border);
  z-index: 50;
}

.sidebar-brand {
  min-height: 82px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid var(--border);
}

.brand-mark {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: var(--accent);
  color: white;
  font-size: 13px;
  font-weight: 800;
}

.sidebar-brand strong {
  display: block;
  font-size: 14px;
}

.sidebar-brand span {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 11px;
}

.sidebar-close {
  display: none;
  margin-left: auto;
  background: transparent;
  color: var(--muted);
  font-size: 25px;
  cursor: pointer;
}

.sidebar-nav {
  flex: 1;
  padding: 20px 13px;
  overflow-y: auto;
}

.nav-section {
  padding: 20px 12px 8px;
  color: var(--muted-2);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.nav-item {
  min-height: 43px;
  margin: 3px 0;
  padding: 0 12px;
  display: flex;
  align-items: center;
  gap: 11px;
  border-radius: 9px;
  color: var(--muted);
  font-size: 13px;
  transition: 0.2s ease;
}

.nav-item:hover {
  background: var(--surface-2);
  color: var(--text);
}

.nav-item.active {
  background: var(--accent-soft);
  color: var(--text);
}

.nav-icon {
  width: 19px;
  text-align: center;
  color: var(--muted);
}

.nav-item.active .nav-icon {
  color: var(--accent);
}

.nav-badge {
  margin-left: auto;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  display: grid;
  place-items: center;
  border-radius: 20px;
  background: var(--accent);
  color: white;
  font-size: 10px;
  font-weight: 700;
}

.sidebar-bottom {
  padding: 15px;
  border-top: 1px solid var(--border);
}

.logout-button {
  width: 100%;
  min-height: 42px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 12px;
  border-radius: 9px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
}

.logout-button:hover {
  background: rgba(239, 107, 115, 0.08);
  color: var(--danger);
}

.main-area {
  width: calc(100% - var(--sidebar-width));
  margin-left: var(--sidebar-width);
}

.topbar {
  height: 82px;
  padding: 0 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  background: rgba(13, 15, 19, 0.84);
  backdrop-filter: blur(14px);
  position: sticky;
  top: 0;
  z-index: 30;
}

.topbar-title {
  font-size: 13px;
  font-weight: 650;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.notification-button {
  width: 38px;
  height: 38px;
  position: relative;
  border-radius: 10px;
  background: var(--surface);
  color: var(--muted);
  cursor: pointer;
}

.notification-button span {
  width: 7px;
  height: 7px;
  position: absolute;
  top: 7px;
  right: 7px;
  border-radius: 50%;
  background: var(--danger);
  border: 2px solid var(--bg);
}

.user-profile {
  display: flex;
  align-items: center;
  gap: 10px;
}

.user-avatar {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--surface-3);
  color: var(--text);
  font-size: 12px;
  font-weight: 800;
}

.user-info strong {
  display: block;
  font-size: 12px;
}

.user-info small {
  display: block;
  margin-top: 2px;
  color: var(--muted);
  font-size: 10px;
}

.menu-button {
  display: none;
  background: transparent;
  color: var(--text);
  font-size: 21px;
  cursor: pointer;
}

.dashboard {
  width: min(1400px, 100%);
  margin: 0 auto;
  padding: 34px;
}

.hero {
  min-height: 330px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 46px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background:
    linear-gradient(115deg, #171a22 0%, #151820 55%, #211e38 100%);
}

.hero-content {
  width: 57%;
  position: relative;
  z-index: 3;
}

.eyebrow,
.section-label {
  color: var(--accent);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.hero h1 {
  max-width: 590px;
  margin-top: 13px;
  font-size: clamp(30px, 4vw, 47px);
  line-height: 1.06;
  letter-spacing: -0.035em;
}

.hero h1 strong {
  display: block;
  color: var(--accent);
}

.hero p {
  max-width: 530px;
  margin-top: 17px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

.hero-actions {
  margin-top: 25px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.primary-button,
.secondary-button {
  min-height: 42px;
  padding: 0 17px;
  border-radius: 9px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
}

.primary-button {
  background: var(--accent);
  color: white;
}

.secondary-button {
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
}

.hero-visual {
  width: 43%;
  height: 100%;
  min-height: 280px;
  position: absolute;
  right: 0;
  top: 0;
}

.microphone {
  width: 105px;
  height: 190px;
  position: absolute;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%);
  z-index: 3;
}

.mic-head {
  width: 72px;
  height: 120px;
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  border: 7px solid #c7c4ff;
  border-radius: 45px;
  background: linear-gradient(135deg, #8b7cff, #5f53c9);
  box-shadow: 0 20px 55px rgba(139, 124, 255, 0.3);
}

.mic-body {
  width: 92px;
  height: 70px;
  position: absolute;
  left: 50%;
  top: 52px;
  transform: translateX(-50%);
  border: 6px solid rgba(232, 230, 255, 0.65);
  border-top: 0;
  border-radius: 0 0 55px 55px;
}

.mic-base {
  width: 78px;
  height: 7px;
  position: absolute;
  bottom: 25px;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 10px;
  background: #aaa5ff;
}

.sound-wave {
  position: absolute;
  left: 50%;
  top: 48%;
  border: 1px solid rgba(139, 124, 255, 0.32);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.wave-one {
  width: 190px;
  height: 190px;
}

.wave-two {
  width: 290px;
  height: 290px;
}

.wave-three {
  width: 390px;
  height: 390px;
}

.visual-orbit {
  position: absolute;
  border: 1px dashed rgba(255, 255, 255, 0.09);
  border-radius: 50%;
}

.orbit-one {
  width: 330px;
  height: 150px;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%) rotate(-25deg);
}

.orbit-two {
  width: 300px;
  height: 120px;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%) rotate(35deg);
}

.section-heading {
  margin: 34px 0 16px;
}

.section-heading h2,
.panel-header h2 {
  margin-top: 5px;
  font-size: 17px;
  letter-spacing: -0.02em;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
}

.stat-card {
  min-height: 115px;
  padding: 19px;
  display: flex;
  align-items: center;
  gap: 14px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: var(--surface);
}

.stat-icon {
  width: 42px;
  height: 42px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: var(--surface-3);
  color: var(--accent);
  font-size: 16px;
}

.stat-card span {
  display: block;
  color: var(--muted);
  font-size: 11px;
}

.stat-card strong {
  display: inline-block;
  margin-top: 5px;
  font-size: 25px;
}

.stat-card small {
  margin-left: 5px;
  color: var(--muted-2);
  font-size: 9px;
}

.dashboard-columns {
  margin-top: 13px;
  display: grid;
  grid-template-columns: 1.45fr 1fr;
  gap: 13px;
}

.panel-card {
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: var(--surface);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-button {
  background: transparent;
  color: var(--accent);
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.activity-list {
  margin-top: 18px;
}

.activity-item {
  display: flex;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.activity-item:last-child {
  border-bottom: 0;
}

.activity-icon {
  width: 35px;
  height: 35px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 12px;
}

.activity-content strong {
  display: block;
  font-size: 11px;
}

.activity-content p {
  margin-top: 3px;
  color: var(--muted);
  font-size: 10px;
}

.activity-content small {
  display: block;
  margin-top: 5px;
  color: var(--muted-2);
  font-size: 9px;
}

.quick-actions {
  margin-top: 17px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}

.quick-action {
  min-height: 105px;
  padding: 14px;
  text-align: left;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: var(--surface-2);
  color: var(--text);
  cursor: pointer;
  transition: 0.2s ease;
}

.quick-action:hover {
  border-color: rgba(139, 124, 255, 0.5);
  transform: translateY(-2px);
}

.quick-action > span {
  display: block;
  color: var(--accent);
  font-size: 16px;
}

.quick-action strong {
  display: block;
  margin-top: 9px;
  font-size: 11px;
}

.quick-action small {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
}

.sidebar-overlay {
  display: none;
}

@media (max-width: 1100px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-columns {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.25s ease;
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .sidebar-close {
    display: block;
  }

  .sidebar-overlay.visible {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 40;
  }

  .main-area {
    width: 100%;
    margin-left: 0;
  }

  .menu-button {
    display: block;
  }

  .topbar {
    height: 66px;
    padding: 0 17px;
  }

  .topbar-title {
    margin-right: auto;
    margin-left: 13px;
  }

  .user-info {
    display: none;
  }

  .dashboard {
    padding: 17px;
  }

  .hero {
    min-height: 500px;
    padding: 27px;
    align-items: flex-start;
  }

  .hero-content {
    width: 100%;
  }

  .hero-visual {
    width: 100%;
    height: 230px;
    top: auto;
    bottom: -25px;
  }

  .hero h1 {
    font-size: 32px;
  }

  .hero p {
    font-size: 12px;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .stat-card {
    min-height: 100px;
    padding: 14px;
  }

  .stat-icon {
    width: 35px;
    height: 35px;
  }
}

@media (max-width: 480px) {
  .stats-grid {
    gap: 8px;
  }

  .stat-card {
    gap: 9px;
    padding: 12px;
  }

  .stat-card strong {
    font-size: 21px;
  }

  .stat-card small {
    display: block;
    margin-left: 0;
  }

  .hero {
    min-height: 490px;
    border-radius: 17px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .primary-button,
  .secondary-button {
    width: 100%;
  }

  .quick-actions {
    grid-template-columns: 1fr;
  }
}
